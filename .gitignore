Data Hub Folder/

# What the tool learned about each screen after a run that worked. Local to
# this machine and this account: the screens a profile describes are the ones
# this user is permitted to open.
# Anchored to the repo root (leading slash): an unanchored "screens/" also
# silently matched src/gmes/screens/, the new package holding screen-generic
# filter/grid/date logic, and git dropped it with no warning.
/screens/

demo_*.png

# Run logs - they contain filter values and row counts, i.e. production data.
logs/

# Raw agent session transcripts. Some contain live G-MES session tokens
# (tokenId/refreshTokenId JWTs) pasted during debugging - CLAUDE.md 2.3
# forbids committing those under any circumstance.
Doc/

# Isolated agent worktrees are local implementation sandboxes.
.worktrees/

# Local orchestration ledger and agent review artifacts.
.superpowers/
